      },
      "expected": "{\"a\":{\"y\":{},\"z\":[]},\"b\":[true,false,null,0,-1,9007199254740991]}"
    },
    {
      "name": "controls-and-separators",
      "input": [
        "\u0000\u001f \b\t\f"
